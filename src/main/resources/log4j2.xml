<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout
        pattern="%d{yyyy-MM-dd HH:mm:ss} [%p] %c - %m%n" />
    </Console>

    <Routing name="PerTestRouting">
      <Routes pattern="${ctx:logFileName}">
        <Route>
          <File name="TestFileAppender"
            fileName="target/logs/${ctx:logFileName}.log"
            append="false">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss} [%p] %c - %m%n" />
          </File>
        </Route>
      </Routes>
    </Routing>
  </Appenders>

  <Loggers>
    <!-- Root logger -->
    <Root level="${sys:logLevel:-INFO}">
      <AppenderRef ref="Console" />
      <AppenderRef ref="PerTestRouting" />
    </Root>

    <!-- Suppress Apache HTTP client debug logs -->
    <Logger name="org.apache.hc.client5" level="WARN" additivity="false"/>
    <Logger name="org.apache.hc.core5" level="WARN" additivity="false"/>
    <Logger name="org.apache.http" level="WARN" additivity="false"/>
    <Logger name="org.apache" level="WARN" additivity="false"/>

    <Logger name="org.openqa.selenium" level="info" />
    <Logger name="io.github.bonigarcia" level="info" />
  </Loggers>
</Configuration>
